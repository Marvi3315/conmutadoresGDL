# Copia este archivo como ".env" (sin ".example") y pega aquí los valores
# de tu proyecto de Firebase. Ver README.md, sección "Configurar Firebase",
# para saber dónde encontrar cada uno.
#
# Este archivo .env.example SÍ se sube al repositorio (son solo etiquetas,
# sin valores). El archivo .env real NUNCA se sube (ya está en .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
