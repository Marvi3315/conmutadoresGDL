rules_version = '2';

// Reglas de seguridad de Firestore para Conmutadores GDL.
//
// - Cualquier visitante del sitio puede LEER el catálogo (para que se muestre
//   públicamente en la página).
// - Solo un usuario autenticado (el correo que crees en Firebase Authentication
//   para el Lic. Felipe Romo) puede CREAR, EDITAR o BORRAR productos.
//
// Cómo publicar estas reglas: Firebase Console → Firestore Database → Reglas →
// pega este contenido → Publicar. (Ver README.md para la guía completa).
service cloud.firestore {
  match /databases/{database}/documents {
    match /catalog/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Por seguridad, cualquier otra colección queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
